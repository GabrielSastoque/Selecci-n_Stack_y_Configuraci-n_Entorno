<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Lista de Contenidos</title>
</head>
<body>
    <h1>Películas y series</h1>
    <ul>
        <% contenidos.forEach(contenido => { %>
            <li>
                <strong><%= contenido.titulo %></strong>
                - <%= contenido.genero %>
                (<%= contenido.anioEstreno %>)
            </li>
        <% }) %>
    </ul>
</body>
</html>