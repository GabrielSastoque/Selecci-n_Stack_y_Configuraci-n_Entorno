<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= receta.nombre %></title>
  <style>
    body { font-family: sans-serif; margin: 30px; background: #f4f4f9; }
    header { background: #d35400; color: white; padding: 20px; border-radius: 8px; }
    main { margin-top: 20px; background: white; padding: 20px; border-radius: 8px; }
    ul { list-style: none; padding: 0; }
    li { padding: 8px 0; border-bottom: 1px solid #eee; }
  </style>
</head>
<body>

  <header>
    <h1><%= receta.nombre %></h1>
    <p>Tipo de cocina: <strong><%= receta.tipoCocina %></strong></p>
    <p>Origen: <strong><%= receta.origen.region %>, <%= receta.origen.pais %></strong></p>
  </header>

  <main>
    <p><strong>Tiempo de preparación:</strong> <%= receta.tiempoPreparacion %></p>

    <h2>Ingredientes</h2>
    <ul>
      <% receta.ingredientes.forEach(ing => { %>
        <li>
          <strong><%= ing.nombre %></strong>: <%= ing.cantidad %> <%= ing.unidad %>
        </li>
      <% }); %>
    </ul>
  </main>

</body>
</html>